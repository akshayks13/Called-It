# Copy to .env.local and fill in. Never commit .env.local.

# Required for AI reading. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Comma-separated, tried in order.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional backup provider, used only when Gemini refuses. Free key: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=

# Optional per-visitor limits on AI requests (defaults shown)
# AI_PER_MINUTE=12
# AI_PER_DAY_PER_VISITOR=60
