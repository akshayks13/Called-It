# Optional configuration. The app runs for free without this file or any keys.
# Never commit .env.local. External AI stays off unless explicitly enabled.
AI_ENABLED=false

# Optional AI enhancement; not needed for gameplay. Check provider quotas first.
# To opt in, set AI_ENABLED=true and supply your own key.
GEMINI_API_KEY=

# Optional. Comma-separated, tried in order.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional backup provider, used only when AI is enabled and Gemini fails.
# GROQ_API_KEY=
# GROQ_MODEL=

# Optional per-visitor limits on AI requests (defaults shown)
# AI_PER_MINUTE=12
# AI_PER_DAY_PER_VISITOR=60
